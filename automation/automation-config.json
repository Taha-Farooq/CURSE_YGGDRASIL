{
  "version": "1.0",
  "loopIntervalMinutes": 30,
  "strictQualityGate": true,
  "paths": {
    "reportsDir": "reports",
    "feedbackInboxDir": "feedback/inbox",
    "feedbackArchiveDir": "feedback/archive",
    "botReportsDir": "reports/bots"
  },
  "bots": {
    "validationBot": {
      "enabled": true,
      "failOnQualityGateError": true
    },
    "worldExplorerBot": {
      "enabled": true,
      "requiredScenarios": [
        "SCN-001",
        "SCN-002",
        "SCN-003",
        "SCN-004",
        "SCN-005"
      ]
    },
    "routeClearabilityBot": {
      "enabled": true,
      "minClearabilityScore": 0.75
    },
    "engineTestBot": {
      "enabled": true,
      "testCommand": "",
      "allowPlaceholderPassWhenNoEngine": true
    },
    "architectureExtendabilityBot": {
      "enabled": true,
      "requiredKeywords": [
        "non-Euclidean",
        "tiered simulation",
        "authority",
        "replay",
        "magitech interop"
      ]
    },
    "errorCheckerBot": {
      "enabled": true,
      "maxAllowedCriticalFindings": 0
    },
    "bugFixerBot": {
      "enabled": true,
      "mode": "suggest",
      "maxSuggestionsPerRun": 10
    },
    "featureSuggesterBot": {
      "enabled": true,
      "maxSuggestionsPerRun": 8
    },
    "taskPlannerBot": {
      "enabled": true,
      "maxTasksPerRun": 120
    },
    "systemBuilderBot": {
      "enabled": true,
      "autoScaffold": true
    },
    "implementationBot": {
      "enabled": true,
      "mode": "scaffold_only",
      "maxFileChangesPerRun": 20
    },
    "teamGrowthBot": {
      "enabled": true,
      "maxNewRolesPerRun": 3
    },
    "testResearchBot": {
      "enabled": true,
      "maxRecommendationsPerRun": 40
    },
    "botMakerBot": {
      "enabled": true,
      "maxBotsToCreatePerRun": 5,
      "onlyCreateIfMissing": true
    },
    "generatedTestBots": {
      "enabled": true,
      "maxBotsPerRun": 25
    },
    "goalAlignmentBot": {
      "enabled": true,
      "goalPath": "automation/goals/current-direction.json"
    },
    "autonomousDriftReportBot": {
      "enabled": true,
      "maxFindings": 40
    },
    "phase1ExecutionBot": {
      "enabled": true,
      "maxRecommendations": 6
    },
    "testFreshnessPolicy": {
      "maxAgeHours": 24
    }
  }
}

